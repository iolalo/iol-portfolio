{
  "name": "IOL Bot - Telegram Approval Poll",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nreturn [{ json: { offset: store.telegramOffset || 0 } }];"
      },
      "id": "code-offset",
      "name": "Load Offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot8371990176:AAGaCRV07QU7jqQNRos90_mMsOE1mkMMPI0/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "timeout",
              "value": "0"
            }
          ]
        },
        "options": {}
      },
      "id": "http-get-updates",
      "name": "Get Telegram Updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst result = $json.result || [];\nlet offset = store.telegramOffset || 0;\nconst out = [];\nfor (const upd of result) {\n  offset = Math.max(offset, Number(upd.update_id || 0) + 1);\n  const msg = upd.message || upd.edited_message;\n  if (!msg) continue;\n  const text = String(msg.text || '').trim();\n  const chatId = String(msg.chat?.id || '');\n  if (chatId !== '631408637') continue;\n  const match = text.match(/^\\/(aprobar|approve|rechazar|reject)\\s+([A-Za-z0-9-]+)/i);\n  if (!match) continue;\n  const decision = /aprobar|approve/i.test(match[1]) ? 'approve' : 'reject';\n  const orderId = match[2];\n  out.push({ json: {\n    id: orderId,\n    decision,\n    chat_id: chatId,\n    ack_text: decision === 'approve'\n      ? `✅ Orden ${orderId} aprobada desde Telegram.`\n      : `🚫 Orden ${orderId} rechazada desde Telegram.`\n  }});\n}\nstore.telegramOffset = offset;\nreturn out;"
      },
      "id": "code-parse",
      "name": "Parse Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.0.8:8765/decision",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"id\": $json.id, \"decision\": $json.decision, \"source\": \"telegram\", \"secret\": \"iol-mobile-approval-2026\" }",
        "options": {}
      },
      "id": "http-bridge",
      "name": "Send To Approval Bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8371990176:AAGaCRV07QU7jqQNRos90_mMsOE1mkMMPI0/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"chat_id\": $json.chat_id, \"text\": $json.ack_text }",
        "options": {}
      },
      "id": "http-ack",
      "name": "Send Ack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        0
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Load Offset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Offset": {
      "main": [
        [
          {
            "node": "Get Telegram Updates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Telegram Updates": {
      "main": [
        [
          {
            "node": "Parse Decisions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Decisions": {
      "main": [
        [
          {
            "node": "Send To Approval Bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send To Approval Bridge": {
      "main": [
        [
          {
            "node": "Send Ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "meta": null,
  "pinData": null,
  "versionId": null
}
