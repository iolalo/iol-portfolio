{
  "name": "IOL Bot - Pending Order Telegram Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "iol-order-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-approval",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "iol-order-approval"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst side = String(body.side || '').toLowerCase();\nconst sideLabel = side === 'buy' ? 'COMPRA' : 'VENTA';\nconst reason = body.reason || 'senal';\nconst orderId = body.id || 'sin-id';\nconst text = [\n  `📋 IOL pendiente #${orderId}`,\n  `${sideLabel} ${body.symbol || '?'}`,\n  `Motivo: ${reason}`,\n  `Cantidad: ${body.qty ?? '?'}`,\n  `Límite: $${body.limit_price ?? '?'}`,\n  '',\n  `Responder: /aprobar ${orderId}`,\n  `o /rechazar ${orderId}`\n].join('\\n');\nreturn [{ json: { chat_id: String(body.chat_id || '631408637'), text } }];"
      },
      "id": "code-message",
      "name": "Build Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8371990176:AAGaCRV07QU7jqQNRos90_mMsOE1mkMMPI0/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"chat_id\": $json.chat_id, \"text\": $json.text }",
        "options": {}
      },
      "id": "http-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, delivered: true } }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        0
      ]
    }
  ],
  "connections": {
